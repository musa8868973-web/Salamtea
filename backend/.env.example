# ============================================================
#  Salamtea Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit your actual .env to version control.
# ============================================================


# ── Server ────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true              # set false in production


# ── Database ──────────────────────────────────────────────────
# Default: SQLite (zero config, great for local dev)
DATABASE_URL=sqlite:///./salamtea.db

# PostgreSQL example (uncomment for production):
# DATABASE_URL=postgresql://salamtea_user:your_password@localhost:5432/salamtea_db


# ── CORS Allowed Origins ──────────────────────────────────────
# Comma-separated list.
# 'null' allows file:// origins (opening HTML directly in browser).
# Replace with your real frontend domain in production.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null


# ── SMTP Email (choose one provider below) ────────────────────

# Option A: Gmail App Password (recommended for small D2C stores)
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to Google Account → Security → App Passwords.
# 3. Generate an "App Password" for "Mail".
# 4. Paste the 16-character code as SMTP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Option B: Mailgun SMTP relay
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASSWORD=your_mailgun_smtp_password

# Option C: SendGrid SMTP relay
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_sendgrid_api_key


# ── Store / Business ──────────────────────────────────────────
FROM_EMAIL=your_gmail@gmail.com
STORE_EMAIL=salamtea.business@gmail.com
STORE_PHONE=+92-300-9002321
WHATSAPP_PHONE=923009002321
